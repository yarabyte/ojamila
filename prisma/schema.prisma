generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  WAITLIST
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
}

enum MealGiftStatus {
  PENDING
  CONSUMED
  CANCELLED
  EXPIRED
}

model User {
  id               String         @id @default(cuid())
  name             String
  phone            String         @unique
  email            String?        @unique
  passwordHash     String?
  role             Role           @default(CLIENT)
  active           Boolean        @default(true)
  cguAcceptedAt    DateTime?
  cguVersion       String?
  subscriptions      Subscription[]
  consumptionsServed Consumption[] @relation("MealsServed")
  pushSubscriptions  PushSubscription[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Formula {
  id              String         @id @default(cuid())
  name            String
  mealsIncluded   Int
  bonusMeals      Int
  priceFcfa       Int
  salesTarget     Int
  hardCap         Int
  dailyMealLimit  Int?
  validityDays    Int            @default(180)
  active          Boolean        @default(true)
  sortOrder       Int            @default(0)
  subscriptions   Subscription[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Subscription {
  id               String             @id @default(cuid())
  client           User               @relation(fields: [clientId], references: [id])
  clientId         String
  formula          Formula            @relation(fields: [formulaId], references: [id])
  formulaId        String
  status           SubscriptionStatus @default(PENDING_PAYMENT)
  totalMeals       Int
  mealsConsumed    Int                @default(0)
  qrToken          String             @unique
  shortCode        String             @unique
  activatedAt      DateTime?
  expiresAt        DateTime?
  waitlistPosition Int?
  paymentMethod    PaymentMethod?
  cguAcceptedAt    DateTime
  cguVersion       String
  consumptions     Consumption[]
  mealGifts        MealGift[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([formulaId, status])
}

model Consumption {
  id             String       @id @default(cuid())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId String
  servedBy       User?        @relation("MealsServed", fields: [servedById], references: [id])
  servedById     String?
  mealGift       MealGift?
  consumedAt     DateTime     @default(now())

  @@index([subscriptionId, consumedAt])
}

model MealGift {
  id               String         @id @default(cuid())
  subscription     Subscription   @relation(fields: [subscriptionId], references: [id])
  subscriptionId   String
  recipientPhone   String
  giftToken        String         @unique
  shortCode        String         @unique
  status           MealGiftStatus @default(PENDING)
  consumption      Consumption?   @relation(fields: [consumptionId], references: [id])
  consumptionId    String?        @unique
  createdAt        DateTime       @default(now())
  consumedAt       DateTime?
  expiresAt        DateTime

  @@index([subscriptionId, status])
  @@index([recipientPhone])
}

model AppSettings {
  id                      String @id @default("singleton")
  dailyMealLimitDefault   Int    @default(1)
  validityDaysDefault     Int    @default(180)
  whatsappMessageTemplate String @default("Bonjour {{name}} ! Votre abonnement JAMILA est prêt. Consultez votre QR ici : {{qrLink}} — Code secours : {{shortCode}}. Conservez-le bien, vous en aurez besoin pour valider vos repas.")
  whatsappGiftTemplate    String @default("Bonjour ! {{senderName}} vous offre un repas chez Ô JAMILA. Présentez ce QR à la caisse — usage unique. Code secours : {{shortCode}}.")
  cguText                 String @db.Text
  cguVersion              String @default("1.0")
  fundraisingGoalFcfa     Int    @default(10000000)
  testPeriodEndsAt        DateTime?
  thankYouMessageTemplate String @default("Merci {{name}} pour votre confiance et votre participation à la soirée des partenaires du 4 juin 2026.\n\nVous avez souscrit à la formule {{formulaName}}. Grâce à vous, nous allons continuer à vous offrir des moments exceptionnels chez Ô JAMILA.\n\nRetrouvez les photos de l'événement ici : {{driveLink}}")
  thankYouDriveUrl        String @default("")
  thankYouLastSentAt      DateTime?
  thankYouLastSentCount   Int?
  updatedAt               DateTime @updatedAt
}
