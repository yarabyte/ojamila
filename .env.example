# PostgreSQL — local OU Supabase (voir docs/SUPABASE.md)
#
# Local : les deux URLs identiques
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jamila?schema=public"
# DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/jamila?schema=public"
#
# Supabase :
# Local dev  : DATABASE_URL = DIRECT_URL (pooler session :5432) — évite les timeouts Prisma
# Vercel prod: DATABASE_URL = Transaction pooler :6543 + ?pgbouncer=true&connection_limit=1
# DIRECT_URL   = Session pooler :5432 (migrations Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jamila?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/jamila?schema=public"

# NextAuth — générer : openssl rand -base64 32
# Local : NEXTAUTH_URL="http://localhost:3000"
# Prod  : NEXTAUTH_URL="https://ojamila.vercel.app"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# QR codes signés (JWT) — générer : openssl rand -base64 32
JWT_QR_SECRET="change-me-qr-secret"

# URL publique de l'app (liens QR / WhatsApp / PWA)
# Local : http://localhost:3000 — Prod : https://ojamila.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp — fournisseur d'envoi automatique
# WHATSAPP_PROVIDER=twilio | meta | auto (défaut : auto = Twilio puis Meta)
WHATSAPP_PROVIDER="twilio"

# --- Option A : Twilio (recommandé si Meta bloque les templates)
# https://console.twilio.com — activer WhatsApp Sandbox ou numéro prod
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Optionnel — Content Template Twilio pour OTP
TWILIO_WHATSAPP_CONTENT_SID=""

# --- Option B : Meta Cloud API direct
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_OTP_TEMPLATE_NAME=""
WHATSAPP_OTP_TEMPLATE_LANGUAGE="fr"

# Web Push (optionnel) — générer : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@ojamila.cm"
